{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de BiciRuta",
  "type": "object",
  "required": ["tienda", "actualizado", "productos"],
  "properties": {
    "tienda": { "type": "string" },
    "actualizado": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "productos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "categoria", "nombre", "precio", "stock"],
        "properties": {
          "ref": { "type": "string", "pattern": "^BR-[0-9]{4}$" },
          "categoria": { "enum": ["bicicleta", "accesorio", "recambio"] },
          "proveedor": { "type": "string" },
          "nombre": { "type": "string" },
          "precio": { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
          "moneda": { "enum": ["EUR", "USD"], "default": "EUR" },
          "stock": { "type": "integer", "minimum": 0 },
          "descripcion": { "type": "string" },
          "caracteristicas": {
            "type": "object",
            "properties": {
              "talla": { "enum": ["S", "M", "L", "XL"] },
              "peso_kg": { "type": "number", "exclusiveMinimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
